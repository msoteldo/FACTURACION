# Copia este archivo a .env para correr en local. NUNCA subas el .env al repo.
# En Render, estas mismas variables van en Environment (como secretos).

# Clave que tu frontend manda en el header X-API-Key (inventa una larga y aleatoria).
API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Datos fiscales del receptor (el club)
RFC=
CP=
RAZON_SOCIAL=
CALLE=
NUM_EXT=
NUM_INT=
REFERENCIA=
ESTADO=
MUNICIPIO=
COLONIA=
EMAIL=
REGIMEN_FISCAL_TEXTO=General de Ley Personas Morales

# Opcionales
# HEADLESS=false                 # en local, para ver el navegador
# BROWSER_CHANNEL=chromium       # vacío = chrome-headless-shell (menos RAM, más fácil de detectar)
# CHROMIUM_EXECUTABLE=           # ruta a un Chromium específico
# ANSWER_TIMEOUT_S=600           # espera máxima a que un humano responda (< 15 min por Render)
# NOTIFY_WEBHOOK_URL=            # recibe un POST cada vez que un trabajo necesita a un humano
